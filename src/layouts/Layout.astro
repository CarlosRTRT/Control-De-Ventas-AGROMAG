---
interface Props { title: string }
const { title } = Astro.props;
const admin = Astro.locals.admin;
const msg = Astro.url.searchParams.get('msg');
const ok = Astro.url.searchParams.has('ok');
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{title} · Agromag Control de Ventas</title>
    <link rel="icon" type="image/png" href="/favicon.png" />
  </head>
  <body>
    <header>
      <div class="marca">
        <img src="/logo.png" alt="" width="52" height="52" />
        <div>
          <b>Agromag</b> <span class="sistema">Control de Ventas</span>
          <small>{title}</small>
        </div>
      </div>
      {admin && (
        <nav>
          <a href="/admin">Panel</a>
          <a href="/admin/historial">Historial</a>
          <form method="post" action="/logout"><button>Salir</button></form>
        </nav>
      )}
    </header>
    <main>
      {msg && <p class:list={['msg', { ok }]}>{msg}</p>}
      <slot />
    </main>
  </body>
</html>

<style is:global>
  body{font-family:system-ui,sans-serif;margin:0;background:#f4f6f5;color:#1d2a24}
  header{display:flex;flex-wrap:wrap;gap:8px;justify-content:space-between;align-items:center;padding:12px 16px;background:#2f6f4f;color:#fff}
  header button{background:#ffffff22;border:1px solid #ffffff66}
  header form{margin:0}
  .marca{display:flex;align-items:center;gap:10px}
  .marca img{background:#fff;border-radius:50%;padding:2px}
  .marca b{font-size:1.2rem}
  .marca .sistema{opacity:.9}
  .marca small{display:block;opacity:.8}
  nav{display:flex;gap:14px;align-items:center}
  nav a{color:#fff}
  main{max-width:1000px;margin:auto;padding:16px}
  section{background:#fff;border-radius:10px;padding:16px;margin-bottom:16px;box-shadow:0 1px 3px #0001}
  h2{margin-top:0;font-size:1.15rem}
  label{display:block;margin:10px 0 4px;font-weight:600}
  label.op{font-weight:400}
  input,select,button{font:inherit;padding:8px;border:1px solid #bbb;border-radius:6px;box-sizing:border-box}
  .full input:not([type=radio]),.full select{width:100%}
  button{background:#2f6f4f;color:#fff;border:0;cursor:pointer;padding:9px 16px}
  .grid{display:grid;grid-template-columns:2fr 1fr 1fr auto;gap:6px;margin-bottom:6px}
  .grid.emp{grid-template-columns:1fr auto}
  table{width:100%;border-collapse:collapse;font-size:.92rem}
  td,th{padding:6px;border-bottom:1px solid #e3e3e3;text-align:left}
  .msg{padding:10px;border-radius:6px;background:#fff3cd}
  .msg.ok{background:#d1f0dc}
  .wrap{overflow-x:auto}
  .tot{display:flex;flex-wrap:wrap;gap:12px;align-items:center;margin-bottom:10px}
  .tot div{background:#eef5f1;padding:8px 12px;border-radius:6px}
  @media(max-width:600px){.grid{grid-template-columns:1fr 1fr}}
</style>
