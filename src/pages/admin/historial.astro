---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { db, hoy, crc, MOVIMIENTOS_SQL } from '../../lib/db';
import { numeroDe, tokenPorNumero } from '../../lib/comprobante';

// Buscador: escribe el N° de una factura (de cualquier día) y se abre.
const buscado = Astro.url.searchParams.get('n');
if (buscado) {
  const token = tokenPorNumero(buscado);
  return Astro.redirect(token ? `/admin/recibo/${token}` : '/admin/historial?msg=' + encodeURIComponent(`No se encontró la factura N° ${buscado.trim().toUpperCase().slice(0, 12)}`), 303);
}

const q = Astro.url.searchParams.get('dia') || '';
const dia = /^\d{4}-\d{2}-\d{2}$/.test(q) ? q : hoy();
const mover = (n: number) => {
  const d = new Date(dia + 'T12:00:00');
  d.setDate(d.getDate() + n);
  return d.toLocaleDateString('sv');
};
const ventas = db.prepare(`${MOVIMIENTOS_SQL} WHERE fecha >= ? AND fecha < date(?, '+1 day') ORDER BY fecha, origen, id`).all(dia, dia) as any[];
// Una venta con varios renglones (animal + producto + servicio) cuenta como UNA venta.
const cuentaVentas = new Set(ventas.map((v: any) => v.token ?? `${v.origen}${v.id}`)).size;
const hayFactura = ventas.some((v: any) => v.factura); // la columna solo aparece si alguna venta vieja trae factura
const tipoDe = (v: any) => (v.clase === 'servicio' ? 'Servicio' : v.clase === 'producto' ? 'Producto' : 'Animal');
const cierres = [...new Set(ventas.filter(v => v.cierre).map(v => v.cierre.slice(11, 16)))];
const pendientes = ventas.filter(v => !v.cierre).length;
const titulo = new Date(dia + 'T12:00:00').toLocaleDateString('es-CR', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' });
const esHoy = dia === hoy();

let total = 0, sinpe = 0, tarjeta = 0;
const porEmpleado: Record<string, number> = {};
for (const v of ventas) {
  const t = v.cantidad * v.precio_unit;
  total += t;
  if (v.metodo === 'sinpe') sinpe += t; else tarjeta += t;
  porEmpleado[v.nombre] = (porEmpleado[v.nombre] || 0) + t;
}
---
<AdminLayout title="Historial" activo="historial">
  <div class="agro-title-row">
    <div>
      <h1 class="agro-title">Historial</h1>
      <p class="agro-intro">{esHoy ? 'Hoy · ' : ''}<span class="dia">{titulo}</span></p>
    </div>
    <form data-astro-reload class="nav-dia">
      <a class="action" href={`?dia=${mover(-1)}`} aria-label="Día anterior"><i aria-hidden="true" class="ti ti-chevron-left"></i></a>
      <input class="field" type="date" name="dia" value={dia} max={hoy()} aria-label="Elegir día" onchange="this.form.submit()" />
      {esHoy
        ? <span class="action off" aria-hidden="true"><i class="ti ti-chevron-right"></i></span>
        : <a class="action" href={`?dia=${mover(1)}`} aria-label="Día siguiente"><i aria-hidden="true" class="ti ti-chevron-right"></i></a>}
      {!esHoy && <a class="action" href="?">Hoy</a>}
      <input class="field buscar-n" name="n" placeholder="N° de factura" maxlength="6" autocomplete="off" autocapitalize="characters" aria-label="Buscar factura por número" />
      <button class="action">Buscar</button>
    </form>
  </div>

  <section aria-labelledby="sales-title" class="sales-empty">
    <h2 class="sales-empty-title" id="sales-title">Ventas del día</h2>
    {ventas.length ? (
      <div class="sales-empty-copy">
        <p>
          <b>{cuentaVentas} venta{cuentaVentas > 1 && 's'}</b> por <b>{crc(total)}</b>
          <span class="sep">·</span> SINPE {crc(sinpe)} <span class="sep">·</span> Tarjeta {crc(tarjeta)}
        </p>
        <p class="por-empleado">
          {Object.entries(porEmpleado).map(([n, t], i) => <>{i > 0 && <span class="sep">·</span>}{n} {crc(t)} </>)}
        </p>
        <p class="por-empleado">
          {cierres.map(h => <span class="cierre"><i aria-hidden="true" class="ti ti-lock"></i>Cierre a las {h}</span>)}
          {pendientes > 0 && <span class="cierre pendiente">{pendientes} sin cerrar</span>}
        </p>
      </div>
    ) : <p class="sales-empty-copy">No hubo ventas este día.</p>}
    <span></span>
  </section>

  {ventas.length > 0 && (
    <>
      <div class="ventas" role="region" aria-label="Ventas del día" tabindex="0">
        <table>
          <thead>
            <tr>
              <th scope="col">Hora</th><th scope="col">N° factura</th><th scope="col">Empleado</th><th scope="col">Detalle</th><th scope="col">Tipo</th>
              <th scope="col" class="num">Cant.</th><th scope="col" class="num">Precio</th><th scope="col" class="num">Total</th>
              <th scope="col">Método</th>{hayFactura && <th scope="col">Factura</th>}
            </tr>
          </thead>
          <tbody>
            {ventas.map(v => (
              <tr>
                <td class="fecha">{v.fecha.slice(11, 16)}</td>
                <td>{v.token ? <a class="n-factura" href={`/admin/recibo/${v.token}`} title="Ver la factura">{numeroDe(v.token)}</a> : <span class="sin-factura">—</span>}</td>
                <td>{v.nombre}</td>
                <td>{v.tipo}</td>
              <td><span class:list={['clase', v.clase]}>{tipoDe(v)}</span></td>
                <td class="num">{v.origen === 's' ? '—' : v.cantidad}</td>
                <td class="num">{crc(v.precio_unit)}</td>
                <td class="num fuerte">{crc(v.cantidad * v.precio_unit)}</td>
                <td><span class:list={['metodo', v.metodo]}>{v.metodo === 'sinpe' ? 'SINPE' : 'Tarjeta'}</span></td>
                {hayFactura && (
                <td>{v.factura ? <a class="factura" href={`/factura/${v.factura}`} target="_blank">Ver <i aria-hidden="true" class="ti ti-arrow-up-right"></i></a> : <span class="sin-factura">—</span>}</td>
              )}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="desliza"><i aria-hidden="true" class="ti ti-arrows-horizontal"></i>Desliza la tabla para ver todas las columnas</p>
    </>
  )}
</AdminLayout>

<style>
  .agro-title-row { display: flex; align-items: end; justify-content: space-between; gap: 28px; flex-wrap: wrap; padding-bottom: 25px; border-bottom: 1px solid var(--line); }
  .agro-title { margin: 0; font: 600 38px/1.06 'Space Grotesk', sans-serif; letter-spacing: -.055em; }
  .agro-intro { margin: 10px 0 0; color: var(--muted); font-size: 16px; line-height: 1.55; }
  .dia::first-letter { text-transform: uppercase; }
  .nav-dia { display: flex; gap: 8px; align-items: center; margin: 0; }
  .nav-dia .field { width: auto; }
  .nav-dia .buscar-n { width: 160px; text-transform: uppercase; letter-spacing: .08em; }
  .nav-dia .action { min-width: 48px; }
  .off { opacity: .35; pointer-events: none; }

  .sales-empty { display: grid; grid-template-columns: 190px minmax(0, 1fr); align-items: center; gap: 22px; margin: 22px 0 35px; padding: 17px 22px; background: var(--soft); border-radius: 3px; }
  .sales-empty:has(+ .ventas) { margin-bottom: 0; }
  .sales-empty-title { margin: 0; font: 600 17px 'Space Grotesk', sans-serif; letter-spacing: -.025em; }
  .sales-empty-copy { margin: 0; color: #34473b; font-size: 15px; line-height: 1.5; }
  .sales-empty-copy p { margin: 0; }
  .sales-empty span:empty { display: none; }
  .sep { margin: 0 4px; color: #8a9a90; }
  .por-empleado { color: var(--muted); font-size: 13px; }
  .cierre { display: inline-flex; align-items: center; gap: 4px; margin-right: 12px; color: var(--deep); font-weight: 700; }
  .cierre.pendiente { color: #8a5a12; }

  .ventas { margin: 0 0 35px; background: #fff; border-bottom: 1px solid var(--line); overflow-x: auto; }
  .ventas table { width: 100%; min-width: 760px; border-collapse: collapse; text-align: left; }
  .ventas th { padding: 12px 18px; color: var(--muted); font-size: 13px; font-weight: 700; white-space: nowrap; border-bottom: 1px solid var(--line); }
  .ventas td { padding: 13px 18px; font-size: 15px; border-top: 1px solid #e1e7e2; white-space: nowrap; }
  .ventas tr:hover td { background: #fbfcfb; }
  .ventas .num { text-align: right; font-variant-numeric: tabular-nums; }
  .fecha { color: var(--muted); font-variant-numeric: tabular-nums; }
  .fuerte { font-weight: 700; }
  .n-factura { color: var(--deep); font: 700 13px 'Space Grotesk', sans-serif; letter-spacing: .08em; text-decoration: underline; text-underline-offset: 3px; }
  .n-factura:hover { color: var(--green); }
  .metodo { display: inline-block; padding: 3px 10px; border-radius: 999px; font-size: 12px; font-weight: 700; }
  .metodo.sinpe { background: #e8f0fb; color: #2b5a99; }
  .metodo.tarjeta { background: #f1ecf8; color: #634594; }
  .clase { display: inline-block; padding: 3px 10px; border-radius: 999px; font-size: 12px; font-weight: 700; background: #eef2ef; color: #4d5f54; }
  .clase.producto { background: #e5f0f6; color: #2d5b7a; }
  .clase.servicio { background: #fdf1dc; color: #8a5a12; }
  .factura { display: inline-flex; align-items: center; gap: 4px; color: var(--deep); font-weight: 700; text-decoration: underline; text-underline-offset: 3px; }
  .sin-factura { color: #9aa79f; }
  .desliza { display: none; align-items: center; gap: 7px; margin: 8px 0 35px; color: var(--muted); font-size: 13px; }

  @media (max-width: 760px) { .desliza { display: flex; } }
  @media (max-width: 620px) {
    .agro-title { font-size: 32px; }
    .sales-empty { grid-template-columns: 1fr; gap: 6px; margin: 17px 0 27px; padding: 16px; }
    .sales-empty-title { font-size: 16px; }
  }
</style>
