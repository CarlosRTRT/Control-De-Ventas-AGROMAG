---
import '../styles/transiciones.css';
import { ClientRouter } from 'astro:transitions';
import { randomBytes } from 'node:crypto';
import { db, crc, TOKEN_RE } from '../lib/db';
import { negocio } from '../lib/negocio';

const back = (msg: string, ok = false, recibo = '') => Astro.redirect(`/?msg=${encodeURIComponent(msg)}${ok ? '&ok' : ''}${recibo ? '&recibo=' + recibo : ''}`, 303);

if (Astro.request.method === 'POST') {
  const f = await Astro.request.formData();
  const empleadoId = Number(f.get('empleado')), animalId = Number(f.get('animal')) || 0;
  const cant = Number(f.get('cantidad')), metodo = f.get('metodo');
  const grooming = f.get('grooming') === '1', monto = grooming ? Number(f.get('grooming_monto')) : 0;
  const token = String(f.get('token') || '').slice(0, 64) || null;
  if (!db.prepare('SELECT 1 FROM empleados WHERE id = ? AND activo = 1').get(empleadoId)) return back('Elija quién hizo la venta');
  if (!animalId && !grooming) return back('Elija un animal o marque grooming');
  if (animalId && (!Number.isInteger(cant) || cant < 1)) return back('Cantidad inválida');
  if (grooming && (!Number.isInteger(monto) || monto < 1)) return back('Escriba cuánto cobró por el grooming');
  if (metodo !== 'sinpe' && metodo !== 'tarjeta') return back('Elija SINPE o tarjeta');
  // Todo síncrono desde aquí: ninguna otra petición se intercala en la transacción.
  db.exec('BEGIN IMMEDIATE');
  try {
    // Si el formulario ya se había guardado (respuesta perdida, doble clic, reintento), no se descuenta otra vez.
    if (token && (db.prepare('SELECT 1 FROM ventas WHERE token = ?').get(token) || db.prepare('SELECT 1 FROM servicios WHERE token = ?').get(token))) {
      db.exec('ROLLBACK');
      return back('Esta venta ya estaba registrada. No se descontó otra vez.', true);
    }
    const partes: string[] = [];
    if (animalId) {
      const a = db.prepare('SELECT * FROM animales WHERE id = ?').get(animalId) as any;
      const r = a && db.prepare('UPDATE animales SET cantidad = cantidad - ? WHERE id = ? AND cantidad >= ? AND activo = 1').run(cant, animalId, cant);
      if (!r?.changes) {
        db.exec('ROLLBACK');
        return back(`No hay suficientes ${a ? a.tipo : 'animales'} (quedan ${a?.cantidad ?? 0})`);
      }
      db.prepare('INSERT INTO ventas (empleado_id, animal_id, cantidad, precio_unit, metodo, token) VALUES (?,?,?,?,?,?)')
        .run(empleadoId, animalId, cant, a.precio, metodo, token);
      partes.push(`${cant} ${a.tipo} — ${crc(cant * a.precio)}`);
    }
    if (grooming) {
      // Mismo código que la venta del animal (viven en tablas distintas): un solo comprobante reúne todo.
      db.prepare('INSERT INTO servicios (empleado_id, monto, metodo, token) VALUES (?,?,?,?)')
        .run(empleadoId, monto, metodo, token);
      partes.push(`grooming ${crc(monto)}`);
    }
    db.exec('COMMIT');
    return back(`Venta registrada: ${partes.join(' + ')}`, true, token && TOKEN_RE.test(token) ? token : '');
  } catch (e) {
    db.exec('ROLLBACK');
    throw e;
  }
}

const empleados = db.prepare('SELECT * FROM empleados WHERE activo = 1 ORDER BY nombre').all() as any[];
const animales = db.prepare('SELECT * FROM animales WHERE cantidad > 0 AND activo = 1 ORDER BY tipo').all() as any[];
const tokenVenta = randomBytes(16).toString('hex');
const msg = Astro.url.searchParams.get('msg');
const reciboParam = Astro.url.searchParams.get('recibo') ?? '';
const comprobante = (() => {
  if (!TOKEN_RE.test(reciboParam)) return null;
  const ventas = db.prepare(`SELECT v.*, a.tipo, e.nombre FROM ventas v JOIN animales a ON a.id = v.animal_id
    JOIN empleados e ON e.id = v.empleado_id WHERE v.token = ?`).all(reciboParam) as any[];
  const servicio = db.prepare(`SELECT s.*, e.nombre FROM servicios s JOIN empleados e ON e.id = s.empleado_id WHERE s.token = ?`).get(reciboParam) as any;
  const base = ventas[0] ?? servicio;
  if (!base) return null;
  const lineas = [
    ...ventas.map(v => ({ texto: `${v.cantidad} x ${v.tipo}`, detalle: v.cantidad > 1 ? `${crc(v.precio_unit)} c/u` : '', importe: v.cantidad * v.precio_unit })),
    ...(servicio ? [{ texto: 'Grooming', detalle: '', importe: servicio.monto }] : []),
  ];
  const [dia, hora] = base.fecha.split(' ');
  return {
    nombre: base.nombre, metodo: base.metodo, lineas, total: lineas.reduce((n, l) => n + l.importe, 0),
    fecha: `${dia.split('-').reverse().join('/')} ${hora.slice(0, 5)}`, numero: reciboParam.slice(-6).toUpperCase(),
  };
})();
const verHistorial = !comprobante && Astro.url.searchParams.get('ver') === 'historial';
const desdeHistorial = Astro.url.searchParams.get('desde') === 'historial';
// Historial de ventas desde el último cierre: al hacer el cierre el dueño, esta lista queda vacía.
const historial = (() => {
  if (!verHistorial) return [] as any[];
  const ventas = db.prepare(`SELECT v.token, v.fecha, v.cantidad, v.precio_unit, v.metodo, a.tipo, e.nombre FROM ventas v
    JOIN animales a ON a.id = v.animal_id JOIN empleados e ON e.id = v.empleado_id WHERE v.cierre IS NULL AND v.token IS NOT NULL`).all() as any[];
  const servicios = db.prepare(`SELECT s.token, s.fecha, s.monto, s.metodo, e.nombre FROM servicios s
    JOIN empleados e ON e.id = s.empleado_id WHERE s.cierre IS NULL AND s.token IS NOT NULL`).all() as any[];
  const porToken = new Map<string, any>();
  const entrada = (r: any) => porToken.get(r.token) ?? porToken.set(r.token, { token: r.token, fecha: r.fecha, nombre: r.nombre, metodo: r.metodo, partes: [] as string[], total: 0 }).get(r.token);
  for (const v of ventas) { const e = entrada(v); e.partes.push(`${v.cantidad} x ${v.tipo}`); e.total += v.cantidad * v.precio_unit; }
  for (const s of servicios) { const e = entrada(s); e.partes.push('Grooming'); e.total += s.monto; }
  return [...porToken.values()].sort((a, b) => b.fecha.localeCompare(a.fecha));
})();
const pedido = Number(Astro.url.searchParams.get('ancho'));
const ancho = [58, 80].includes(pedido) ? pedido : negocio.anchoPapel; // milímetros del rollo
const ok = Astro.url.searchParams.has('ok');
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>Reportar venta · Agromag Control de Ventas</title>
    <ClientRouter />
    {comprobante && <style set:html={`@page { size: ${ancho}mm auto; margin: 0; }`} />}
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&display=swap" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.48.0/dist/tabler-icons.min.css" rel="stylesheet" />
  </head>
  <body>
    <div class="page">
      <header class="topbar">
        <a aria-label="Agromag, reportar venta" class="brand" href="/">
          <span class="logo-wrap"><img alt="Logo de Agromag" class="logo" src="/logo.png" width="78" height="78" /></span>
          <span class="brand-copy">
            <span class="brand-line"><strong>Agromag</strong> <span>Control de Ventas</span></span>
            <span class="brand-sub">Reportar venta</span>
          </span>
        </a>
        {verHistorial
          ? <a class="top-link" href="/"><i aria-hidden="true" class="ti ti-shopping-cart"></i>Registrar venta</a>
          : <a class="top-link" href="/?ver=historial"><i aria-hidden="true" class="ti ti-receipt"></i>Historial</a>}
      </header>

      <main class="main">
        {comprobante ? (
          <>
            <div class="page-intro no-imprimir">
              <p class="eyebrow">{msg ? 'Venta registrada' : 'Historial de ventas'}</p>
              <h1>Comprobante de la venta</h1>
              <p class="intro-copy">Revíselo e imprímalo para el cliente, o vuelva para registrar otra venta.</p>
            </div>

            {msg && (
              <div class:list={['aviso no-imprimir', ok ? 'aviso-ok' : 'aviso-error']} role="alert">
                <i aria-hidden="true" class:list={['ti', ok ? 'ti-circle-check' : 'ti-alert-circle']}></i>
                <strong>{msg}</strong>
              </div>
            )}

          <article class="papel" style={`width: ${ancho - 8}mm`}>
            <header class="centro">
              <h2>{negocio.nombre}</h2>
              {negocio.detalle && <p>{negocio.detalle}</p>}
              {negocio.lugar && <p>{negocio.lugar}</p>}
              {negocio.telefono && <p>Tel. {negocio.telefono}</p>}
            </header>
            <hr class="sep" />
            <p class="centro"><b>COMPROBANTE DE VENTA</b></p>
            <p class="fila"><span>Fecha:</span><span>{comprobante.fecha}</span></p>
            <p class="fila"><span>Atendió:</span><span>{comprobante.nombre}</span></p>
            <p class="fila"><span>N°:</span><span>{comprobante.numero}</span></p>
            <hr class="sep" />
            {comprobante.lineas.map(l => (
              <div>
                <p class="fila"><span>{l.texto}</span><span>{crc(l.importe)}</span></p>
                {l.detalle && <p class="det">&nbsp;&nbsp;{l.detalle}</p>}
              </div>
            ))}
            <hr class="sep" />
            <p class="fila total"><span>TOTAL</span><span>{crc(comprobante.total)}</span></p>
            <p class="fila"><span>Pago:</span><span>{comprobante.metodo === 'sinpe' ? 'SINPE Móvil' : 'Tarjeta'}</span></p>
            <hr class="sep" />
            {negocio.pie && <p class="centro">{negocio.pie}</p>}
          </article>

            <div class="acciones no-imprimir">
              <button type="button" class="submit" data-imprimir><i aria-hidden="true" class="ti ti-printer"></i>Imprimir factura</button>
              <a class="volver" href={desdeHistorial ? '/?ver=historial' : '/'}>Volver</a>
            </div>
          </>
        ) : verHistorial ? (
          <>
            <div class="page-intro">
              <p class="eyebrow">Historial de ventas</p>
              <h1>Ventas desde el último cierre</h1>
              <p class="intro-copy">Vea o vuelva a imprimir cualquier factura. Esta lista se limpia cuando el dueño hace el cierre del día.</p>
            </div>
            {historial.length ? (
              <ul class="historial">
                {historial.map(h => (
                  <li class="entrada">
                    <div class="entrada-info">
                      <span class="entrada-hora">{h.fecha.slice(11, 16)}</span>
                      <strong>{h.partes.join(' + ')}</strong>
                      <span class="entrada-sub">{h.nombre} · {h.metodo === 'sinpe' ? 'SINPE' : 'Tarjeta'}</span>
                    </div>
                    <span class="entrada-total">{crc(h.total)}</span>
                    <div class="entrada-acciones">
                      <a class="mini" href={`/?recibo=${h.token}&desde=historial`}><i aria-hidden="true" class="ti ti-eye"></i>Ver factura</a>
                      <a class="mini principal" href={`/?recibo=${h.token}&desde=historial&imprimir=1`}><i aria-hidden="true" class="ti ti-printer"></i>Imprimir</a>
                    </div>
                  </li>
                ))}
              </ul>
            ) : <p class="vacio">No hay ventas desde el último cierre.</p>}
          </>
        ) : (
          <>
        <div class="page-intro">
          <p class="eyebrow">Registro de inventario</p>
          <h1>Registrar una venta</h1>
          <p class="intro-copy">Completa los datos de la venta.</p>
        </div>

        {msg && (
          <div class:list={['aviso', ok ? 'aviso-ok' : 'aviso-error']} role="alert">
            <i aria-hidden="true" class:list={['ti', ok ? 'ti-circle-check' : 'ti-alert-circle']}></i>
            <strong>{msg}</strong>
          </div>
        )}

        {!empleados.length ? <p class="vacio">Todavía no hay empleados. El dueño debe agregarlos en Administración.</p>
        : (
          <form data-astro-reload aria-label="Registrar una venta" class="form-card" method="post" id="venta">
            <input type="hidden" name="token" value={tokenVenta} />
            <section aria-label="Datos de la venta" class="fields">
              <div class="field-grid">
                <div class="field">
                  <label class="field-label" for="employee">¿Quién vendió?</label>
                  <select class="select" id="employee" name="empleado" required>
                    <option value="">— Elija su nombre —</option>
                    {empleados.map(e => <option value={e.id}>{e.nombre}</option>)}
                  </select>
                </div>
                <div class="field">
                  <label class="field-label" for="animal">Animal</label>
                  <select class="select" id="animal" name="animal">
                    <option value="">— Sin animal —</option>
                    {animales.map(a => <option value={a.id} data-stock={a.cantidad}>{a.tipo} — {crc(a.precio)} (quedan {a.cantidad})</option>)}
                  </select>
                </div>
              </div>

              <div class="field quantity-field" id="bloque-cantidad" hidden>
                <label class="field-label" for="quantity">Cantidad vendida</label>
                <div class="qty-wrap">
                  <button type="button" class="qty-btn" data-paso="-1" aria-label="Disminuir cantidad"><span aria-hidden="true">−</span></button>
                  <input class="number" id="quantity" min="1" name="cantidad" step="1" type="number" value="1" inputmode="numeric" />
                  <button type="button" class="qty-btn" data-paso="1" aria-label="Aumentar cantidad"><span aria-hidden="true">+</span></button>
                  <span class="unit">unidades</span>
                </div>
              </div>

              <div class="field grooming-field">
                <label class="radio-choice grooming-check"><input type="checkbox" name="grooming" value="1" id="grooming" /><span>Incluir grooming</span></label>
                <div class="grooming-monto" id="bloque-monto" hidden>
                  <label class="field-label" for="grooming-monto">¿Cuánto cobró por el grooming?</label>
                  <div class="money-wrap">
                    <span class="currency" aria-hidden="true">₡</span>
                    <input class="number" id="grooming-monto" name="grooming_monto" type="number" min="1" step="1" inputmode="numeric" placeholder="Monto" />
                  </div>
                </div>
              </div>

              <fieldset>
                <legend class="group-legend">Método de pago</legend>
                <div class="radio-row">
                  <label class="radio-choice"><input name="metodo" required type="radio" value="sinpe" /><span>SINPE</span></label>
                  <label class="radio-choice"><input name="metodo" type="radio" value="tarjeta" /><span>Tarjeta</span></label>
                </div>
              </fieldset>
            </section>


            <div class="card-footer">
              <p class="submit-help">Revisa el nombre, lo vendido y el monto antes de registrar.</p>
              <button class="submit" type="submit">Registrar venta</button>
            </div>
          </form>
        )}
          </>
        )}

      </main>
    </div>

    <script>import '../scripts/avisos';</script>
    <script>
      // Imprime la vista previa (la hoja de estilos de impresión deja solo el comprobante).
      document.addEventListener('click', e => {
        if ((e.target as HTMLElement).closest('[data-imprimir]')) print();
      });

      // Con el cambio de vistas el DOM se reemplaza: se inicializa en cada carga.
      document.addEventListener('astro:page-load', () => {
      // "Imprimir" desde el historial abre el comprobante y lanza la impresión una sola vez.
      const dir = new URL(location.href);
      if (dir.searchParams.has('imprimir') && document.querySelector('.papel')) {
        dir.searchParams.delete('imprimir');
        history.replaceState(history.state, '', dir.pathname + dir.search);
        setTimeout(() => print(), 300);
      }
      const form = document.querySelector<HTMLFormElement>('#venta');
      if (form) {
        const animal = form.querySelector<HTMLSelectElement>('#animal')!;
        const cant = form.querySelector<HTMLInputElement>('#quantity')!;
        const grooming = form.querySelector<HTMLInputElement>('#grooming')!;
        const monto = form.querySelector<HTMLInputElement>('#grooming-monto')!;

        // Sin animal no hay cantidad; con grooming se pide el monto. Se debe elegir al menos una de las dos cosas.
        const sincronizar = () => {
          const hayAnimal = !!animal.value;
          form.querySelector<HTMLElement>('#bloque-cantidad')!.hidden = !hayAnimal;
          cant.disabled = !hayAnimal;
          form.querySelector<HTMLElement>('#bloque-monto')!.hidden = !grooming.checked;
          monto.disabled = !grooming.checked;
          monto.required = grooming.checked;
          animal.required = !grooming.checked;
        };
        animal.addEventListener('change', sincronizar);
        grooming.addEventListener('change', () => { sincronizar(); if (grooming.checked) monto.focus(); });
        sincronizar();

        // La cantidad no puede pasar de lo que hay del animal elegido.
        const limitar = () => {
          const stock = Number(animal.selectedOptions[0]?.dataset.stock);
          if (stock) { cant.max = String(stock); cant.setCustomValidity(Number(cant.value) > stock ? `Solo quedan ${stock}` : ''); }
          else { cant.removeAttribute('max'); cant.setCustomValidity(''); }
        };
        animal.addEventListener('change', limitar);
        cant.addEventListener('input', limitar);
        form.querySelectorAll<HTMLButtonElement>('.qty-btn').forEach(b => b.addEventListener('click', () => {
          const max = Number(cant.max) || Infinity;
          const n = Math.floor(Number(cant.value)) || 1;
          cant.value = String(Math.min(Math.max(1, n + Number(b.dataset.paso)), max));
          limitar();
        }));
      }
      });
    </script>
  </body>
</html>

<style is:global>
  :root { --green: #2f6f4f; --green-deep: #24583f; --green-soft: #eaf2ec; --paper: #f4f6f5; --surface: #fff; --ink: #1d2a24; --muted: #67766d; --line: #dce4df; --line-strong: #c5d3ca; --error: #94463d; --error-bg: #fcf0ed; --error-line: #edc9c2; --shadow: 0 16px 42px rgba(29, 42, 36, .075); --body: 'DM Sans', system-ui, sans-serif; --display: 'Space Grotesk', sans-serif; }
  *, *::before, *::after { box-sizing: border-box; }
  body { margin: 0; background: var(--paper); color: var(--ink); font-family: var(--body); }
  button, input, select { font: inherit; }
  .page { min-height: 100vh; min-height: 100dvh; background: var(--paper); }
  .topbar { height: 112px; display: flex; align-items: center; justify-content: space-between; padding: 0 6.1%; background: var(--green); color: #fff; }
  .brand { display: flex; align-items: center; gap: 18px; min-width: 0; color: inherit; text-decoration: none; }
  .logo-wrap { width: 84px; height: 84px; box-shadow: 0 6px 20px rgba(0, 0, 0, .18); border-radius: 50%; background: #fff; display: grid; place-items: center; flex: none; }
  .logo { width: 78px; height: 78px; object-fit: contain; border-radius: 50%; }
  .brand-copy { line-height: 1.2; }
  .brand-line { font-size: 18px; letter-spacing: -.02em; }
  .brand-line strong { font-family: var(--display); font-size: 26px; font-weight: 700; letter-spacing: -.045em; }
  .brand-sub { display: block; margin-top: 4px; color: rgba(255, 255, 255, .8); font-size: 14px; }
  .main { width: min(720px, calc(100% - 48px)); margin: 0 auto; padding: 46px 0 28px; }
  .page-intro { margin: 0 0 24px 3px; }
  .eyebrow { margin: 0 0 7px; color: var(--green); font-size: 12px; font-weight: 700; letter-spacing: .11em; text-transform: uppercase; }
  h1 { margin: 0; font-family: var(--display); font-size: clamp(28px, 3vw, 38px); line-height: 1.08; letter-spacing: -.055em; font-weight: 600; color: var(--ink); }
  .intro-copy { margin: 9px 0 0; color: var(--muted); font-size: 15px; line-height: 1.55; max-width: 57ch; }

  .aviso { display: flex; align-items: center; gap: 10px; margin: 0 0 18px; padding: 13px 16px; border-radius: 10px; font-size: 14px; }
  .aviso .ti { font-size: 19px; flex: none; }
  .aviso-ok { background: var(--green-soft); color: var(--green-deep); border: 1px solid #cfe0d5; }
  .aviso-error { background: var(--error-bg); color: var(--error); border: 1px solid var(--error-line); }
  .vacio { padding: 28px; text-align: center; color: var(--muted); background: #fff; border: 1px dashed var(--line-strong); border-radius: 14px; }

  .form-card { display: grid; grid-template-columns: minmax(0, 1fr); background: var(--surface); border: 1px solid rgba(47, 111, 79, .1); border-radius: 18px; box-shadow: var(--shadow); overflow: hidden; }
  .fields { padding: 29px 34px 30px; }
  .field-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 18px 20px; }
  .field { min-width: 0; }
  .field-label, .group-legend { display: block; margin: 0 0 8px; color: var(--ink); font-size: 13px; font-weight: 700; line-height: 1.35; }
  .select, .number { width: 100%; height: 48px; border: 1px solid var(--line-strong); border-radius: 9px; background: #fff; color: var(--ink); padding: 0 14px; font-size: 14px; outline: none; transition: border-color .18s, box-shadow .18s; }
  .select:focus-visible, .number:focus-visible { border-color: var(--green); box-shadow: 0 0 0 3px rgba(47, 111, 79, .16); }
  .number:invalid { border-color: var(--error); }
  .quantity-field { margin-top: 20px; max-width: 400px; }
  .qty-wrap { display: flex; align-items: center; gap: 10px; }
  .qty-wrap .number { width: 84px; max-width: 84px; padding: 0 6px; text-align: center; font-size: 18px; font-weight: 700; font-variant-numeric: tabular-nums; -moz-appearance: textfield; appearance: textfield; }
  .qty-wrap .number::-webkit-inner-spin-button, .qty-wrap .number::-webkit-outer-spin-button { -webkit-appearance: none; margin: 0; }
  .qty-btn { width: 44px; height: 44px; flex: none; display: grid; place-items: center; border: 1px solid var(--line-strong); border-radius: 50%; background: #fff; color: var(--green-deep); font-size: 26px; line-height: 1; font-weight: 500; padding: 0 0 2px; cursor: pointer; transition: background .16s, border-color .16s, color .16s, transform .12s; }
  .qty-btn:hover { background: var(--green-soft); border-color: var(--green); }
  .qty-btn:active { transform: scale(.92); background: var(--green); border-color: var(--green); color: #fff; }
  .qty-btn:focus-visible { outline: 3px solid rgba(47, 111, 79, .25); outline-offset: 2px; }
  .unit { font-size: 13px; color: var(--muted); }
