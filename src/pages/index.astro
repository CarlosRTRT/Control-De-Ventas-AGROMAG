---
import '../styles/transiciones.css';
import { ClientRouter } from 'astro:transitions';
import { randomBytes } from 'node:crypto';
import { db, crc, TOKEN_RE } from '../lib/db';
import { negocio } from '../lib/negocio';
import Comprobante from '../components/Comprobante.astro';
import { cargarComprobante, numeroDe } from '../lib/comprobante';

const back = (msg: string, ok = false, recibo = '') => Astro.redirect(`/?msg=${encodeURIComponent(msg)}${ok ? '&ok' : ''}${recibo ? '&recibo=' + recibo : ''}`, 303);

if (Astro.request.method === 'POST') {
  const f = await Astro.request.formData();
  const empleadoId = Number(f.get('empleado')), metodo = f.get('metodo');
  // Un formulario puede traer varios animales: "animal" y "cantidad" llegan en pares, en el mismo orden.
  const cantidades = f.getAll('cantidad').map(Number);
  const pedidos = new Map<number, number>();
  let cantidadMala = false;
  f.getAll('animal').map(Number).forEach((id, i) => {
    if (!id) return; // línea sin animal
    if (!Number.isInteger(cantidades[i]) || cantidades[i] < 1) cantidadMala = true;
    pedidos.set(id, (pedidos.get(id) ?? 0) + cantidades[i]); // el mismo animal repetido se suma
  });
  // Servicios: el empleado solo marca los de la lista del dueño; el precio sale del catálogo.
  const elegidos = [...new Set(f.getAll('servicio').map(Number).filter(Boolean))]
    .map(id => db.prepare('SELECT * FROM catalogo_servicios WHERE id = ? AND activo = 1').get(id) as any);
  const token = String(f.get('token') || '').slice(0, 64) || null;
  if (!db.prepare('SELECT 1 FROM empleados WHERE id = ? AND activo = 1').get(empleadoId)) return back('Elija quién hizo la venta');
  if (!pedidos.size && !elegidos.length) return back('Elija un animal, un producto o un servicio');
  if (cantidadMala) return back('Cantidad inválida');
  if (elegidos.some(s => !s)) return back('Uno de los servicios ya no está disponible');
  if (metodo !== 'sinpe' && metodo !== 'tarjeta') return back('Elija SINPE o tarjeta');
  // Todo síncrono desde aquí: ninguna otra petición se intercala en la transacción.
  db.exec('BEGIN IMMEDIATE');
  try {
    // Si el formulario ya se había guardado (respuesta perdida, doble clic, reintento), no se descuenta otra vez.
    if (token && (db.prepare('SELECT 1 FROM ventas WHERE token = ?').get(token) || db.prepare('SELECT 1 FROM servicios WHERE token = ?').get(token))) {
      db.exec('ROLLBACK');
      return back('Esta venta ya estaba registrada. No se descontó otra vez.', true);
    }
    const partes: string[] = [];
    for (const [animalId, cant] of pedidos) {
      const a = db.prepare('SELECT * FROM animales WHERE id = ?').get(animalId) as any;
      const r = a && db.prepare('UPDATE animales SET cantidad = cantidad - ? WHERE id = ? AND cantidad >= ? AND activo = 1').run(cant, animalId, cant);
      if (!r?.changes) {
        db.exec('ROLLBACK'); // si falta cualquiera de los animales, no se registra nada de la venta
        return back(`No hay suficientes ${a ? a.tipo : 'animales'} (quedan ${a?.cantidad ?? 0})`);
      }
      db.prepare('INSERT INTO ventas (empleado_id, animal_id, cantidad, precio_unit, metodo, token) VALUES (?,?,?,?,?,?)')
        .run(empleadoId, animalId, cant, a.precio, metodo, token);
      partes.push(`${cant} ${a.tipo} — ${crc(cant * a.precio)}`);
    }
    for (const s of elegidos) {
      // Mismo código que el resto de la venta (viven en tablas distintas): un solo comprobante reúne todo.
      db.prepare('INSERT INTO servicios (empleado_id, monto, metodo, token, nombre) VALUES (?,?,?,?,?)')
        .run(empleadoId, s.precio, metodo, token, s.nombre);
      partes.push(`${s.nombre} ${crc(s.precio)}`);
    }
    db.exec('COMMIT');
    return back(`Venta registrada: ${partes.join(' + ')}`, true, token && TOKEN_RE.test(token) ? token : '');
  } catch (e) {
    db.exec('ROLLBACK');
    throw e;
  }
}

const empleados = db.prepare('SELECT * FROM empleados WHERE activo = 1 ORDER BY nombre').all() as any[];
const inventario = db.prepare('SELECT * FROM animales WHERE cantidad > 0 AND activo = 1 ORDER BY tipo').all() as any[];
const animales = inventario.filter(a => a.clase !== 'producto');
const productos = inventario.filter(a => a.clase === 'producto');
const servicios = db.prepare('SELECT * FROM catalogo_servicios WHERE activo = 1 ORDER BY nombre').all() as any[];
const tokenVenta = randomBytes(16).toString('hex');
const msg = Astro.url.searchParams.get('msg');
const reciboParam = Astro.url.searchParams.get('recibo') ?? '';
const comprobante = cargarComprobante(reciboParam);
const verHistorial = !comprobante && Astro.url.searchParams.get('ver') === 'historial';
const desdeHistorial = Astro.url.searchParams.get('desde') === 'historial';
// Historial de ventas desde el último cierre: al hacer el cierre el dueño, esta lista queda vacía.
const historial = (() => {
  if (!verHistorial) return [] as any[];
  const ventas = db.prepare(`SELECT v.token, v.fecha, v.cantidad, v.precio_unit, v.metodo, a.tipo, e.nombre FROM ventas v
    JOIN animales a ON a.id = v.animal_id JOIN empleados e ON e.id = v.empleado_id WHERE v.cierre IS NULL AND v.token IS NOT NULL`).all() as any[];
  const serviciosVendidos = db.prepare(`SELECT s.token, s.fecha, s.monto, s.metodo, s.nombre AS servicio, e.nombre FROM servicios s
    JOIN empleados e ON e.id = s.empleado_id WHERE s.cierre IS NULL AND s.token IS NOT NULL`).all() as any[];
  const porToken = new Map<string, any>();
  const entrada = (r: any) => porToken.get(r.token) ?? porToken.set(r.token, { token: r.token, fecha: r.fecha, nombre: r.nombre, metodo: r.metodo, partes: [] as string[], total: 0 }).get(r.token);
  for (const v of ventas) { const e = entrada(v); e.partes.push(`${v.cantidad} x ${v.tipo}`); e.total += v.cantidad * v.precio_unit; }
  for (const s of serviciosVendidos) { const e = entrada(s); e.partes.push(s.servicio ?? 'Grooming'); e.total += s.monto; }
  return [...porToken.values()].sort((a, b) => b.fecha.localeCompare(a.fecha));
})();
const pedido = Number(Astro.url.searchParams.get('ancho'));
const ancho = [58, 80].includes(pedido) ? pedido : negocio.anchoPapel; // milímetros del rollo
const ok = Astro.url.searchParams.has('ok');
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>Reportar venta · Agromag Control de Ventas</title>
    <ClientRouter />
    {comprobante && <style set:html={`@page { size: ${ancho}mm auto; margin: 0; }`} />}
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&display=swap" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.48.0/dist/tabler-icons.min.css" rel="stylesheet" />
  </head>
  <body>
    <div class="cash-page">
      <header class="cash-top">
        <div class="cash-top-inner">
          <a aria-label="Agromag, reportar venta" class="cash-brand" href="/">
            <img alt="Logo de Agromag" class="cash-logo" src="/logo.png" width="72" height="72" />
            <span>
              <span class="cash-brand-name">Agromag</span>
              <span class="cash-brand-sub">Control de Ventas · Reportar venta</span>
            </span>
          </a>
          {verHistorial
            ? <a class="cash-history" href="/"><i aria-hidden="true" class="ti ti-shopping-cart"></i>Registrar venta</a>
            : <a class="cash-history" href="/?ver=historial"><i aria-hidden="true" class="ti ti-receipt"></i>Historial</a>}
        </div>
      </header>

      <main class="cash-main">
        {comprobante ? (
          <>
            <div class="page-intro no-imprimir">
              <p class="eyebrow">{msg ? 'Venta registrada' : 'Historial de ventas'}</p>
              <h1>Comprobante de la venta</h1>
              <p class="intro-copy">Revíselo e imprímalo para el cliente, o vuelva para registrar otra venta.</p>
            </div>

            {msg && (
              <div class:list={['aviso no-imprimir', ok ? 'aviso-ok' : 'aviso-error']} role="alert">
                <i aria-hidden="true" class:list={['ti', ok ? 'ti-circle-check' : 'ti-alert-circle']}></i>
                <strong>{msg}</strong>
              </div>
            )}

          <Comprobante datos={comprobante} ancho={ancho} />

            <div class="acciones no-imprimir">
              <button type="button" class="cash-submit" data-imprimir><i aria-hidden="true" class="ti ti-printer"></i>Imprimir factura</button>
              <a class="volver" href={desdeHistorial ? '/?ver=historial' : '/'}>Volver</a>
            </div>
          </>
        ) : verHistorial ? (
          <>
            <div class="page-intro">
              <p class="eyebrow">Historial de ventas</p>
              <h1>Ventas desde el último cierre</h1>
              <p class="intro-copy">Vea o vuelva a imprimir cualquier factura. Esta lista se limpia cuando el dueño hace el cierre del día.</p>
            </div>
            {historial.length ? (
              <ul class="historial">
                {historial.map(h => (
                  <li class="entrada">
                    <div class="entrada-info">
                      <span class="entrada-hora">{h.fecha.slice(11, 16)} · N° {numeroDe(h.token)}</span>
                      <strong>{h.partes.join(' + ')}</strong>
                      <span class="entrada-sub">{h.nombre} · {h.metodo === 'sinpe' ? 'SINPE' : 'Tarjeta'}</span>
                    </div>
                    <span class="entrada-total">{crc(h.total)}</span>
                    <div class="entrada-acciones">
                      <a class="mini" href={`/?recibo=${h.token}&desde=historial`}><i aria-hidden="true" class="ti ti-eye"></i>Ver factura</a>
                      <a class="mini principal" href={`/?recibo=${h.token}&desde=historial&imprimir=1`}><i aria-hidden="true" class="ti ti-printer"></i>Imprimir</a>
                    </div>
                  </li>
                ))}
              </ul>
            ) : <p class="vacio">No hay ventas desde el último cierre.</p>}
          </>
        ) : (
          <>
            <div class="cash-intro">
              <h1 class="cash-title">Registrar<br />una venta</h1>
              <p class="cash-intro-copy">Completa los datos de la venta.</p>
            </div>

            {msg && (
              <div class:list={['aviso aviso-hoja', ok ? 'aviso-ok' : 'aviso-error']} role="alert">
                <i aria-hidden="true" class:list={['ti', ok ? 'ti-circle-check' : 'ti-alert-circle']}></i>
                <strong>{msg}</strong>
              </div>
            )}

            {!empleados.length ? <p class="vacio">Todavía no hay empleados. El dueño debe agregarlos en Administración.</p>
            : (
              <form data-astro-reload aria-label="Registrar una venta" class="cash-sheet" method="post" id="venta">
                <input type="hidden" name="token" value={tokenVenta} />
                <div class="sheet-heading">
                  <h2>Datos de la venta</h2>
                </div>

                <div class="seller-row">
                  <label class="row-title" for="employee">¿Quién vendió?</label>
                  <div>
                    <select class="cash-select" id="employee" name="empleado" required>
                      <option value="">— Elija su nombre —</option>
                      {empleados.map(e => <option value={e.id}>{e.nombre}</option>)}
                    </select>
                  </div>
                </div>

                <div class="sale-choice">
                  <section class="animal-area">
                    <div class="animal-field">
                      <div id="lineas">
                        <div class="linea">
                          <div class="linea-animal">
                            <label class="field-label">Animal o producto</label>
                            <select class="cash-select" name="animal" aria-label="Animal o producto">
                              <option value="">— Ninguno —</option>
                              {animales.length > 0 && <optgroup label="Animales">
                                {animales.map(a => <option value={a.id} data-stock={a.cantidad}>{a.tipo} — {crc(a.precio)} (quedan {a.cantidad})</option>)}
                              </optgroup>}
                              {productos.length > 0 && <optgroup label="Productos">
                                {productos.map(a => <option value={a.id} data-stock={a.cantidad}>{a.tipo} — {crc(a.precio)} (quedan {a.cantidad})</option>)}
                              </optgroup>}
                            </select>
                          </div>
                          <div class="linea-cantidad" hidden>
                            <label class="field-label">Cantidad</label>
                            <div class="quantity-control">
                              <button type="button" class="qty-btn" data-paso="-1" aria-label="Disminuir cantidad">−</button>
                              <input name="cantidad" min="1" step="1" type="number" value="1" inputmode="numeric" aria-label="Cantidad" />
                              <button type="button" class="qty-btn" data-paso="1" aria-label="Aumentar cantidad">+</button>
                            </div>
                          </div>
                          <button type="button" class="linea-quitar" hidden aria-label="Quitar este animal">Quitar</button>
                        </div>
                      </div>
                      <p class="conditional-note" id="nota-cantidad">La cantidad se habilita al elegir un animal o producto.</p>
                      <button type="button" class="agregar-linea" id="agregar-linea" hidden><i aria-hidden="true" class="ti ti-plus"></i>Agregar otro animal o producto</button>
                    </div>
                  </section>

                  <section class="grooming-area">
                    <p class="area-titulo">Servicios</p>
                    {servicios.length ? (
                      <div class="servicios-lista">
                        {servicios.map(s => (
                          <label class="grooming-toggle">
                            <input type="checkbox" name="servicio" value={s.id} />
                            <span>{s.nombre}</span>
                            <b class="serv-precio">{crc(s.precio)}</b>
                          </label>
                        ))}
                      </div>
                    ) : <p class="conditional-note">El dueño aún no ha agregado servicios.</p>}
                  </section>
                </div>

                <div class="payment-row">
                  <h2 class="row-title">Método de pago</h2>
                  <fieldset>
                    <legend class="sr-only">Método de pago</legend>
                    <label class="payment-choice"><input name="metodo" required type="radio" value="sinpe" /><span>SINPE</span></label>
                    <label class="payment-choice"><input name="metodo" type="radio" value="tarjeta" /><span>Tarjeta</span></label>
                  </fieldset>
                </div>

                <footer class="cash-footer">
                  <p class="cash-help">Revisa el nombre, lo vendido y el monto antes de registrar.</p>
                  <button class="cash-submit" type="submit">Registrar venta<i aria-hidden="true" class="ti ti-arrow-right"></i></button>
                </footer>
              </form>
            )}
          </>
        )}

      </main>
    </div>

    <script>import '../scripts/avisos';</script>
    <script>
      // Imprime la vista previa (la hoja de estilos de impresión deja solo el comprobante).
      document.addEventListener('click', e => {
        if ((e.target as HTMLElement).closest('[data-imprimir]')) print();
      });

      // Con el cambio de vistas el DOM se reemplaza: se inicializa en cada carga.
      document.addEventListener('astro:page-load', () => {
      // "Imprimir" desde el historial abre el comprobante y lanza la impresión una sola vez.
      const dir = new URL(location.href);
      if (dir.searchParams.has('imprimir') && document.querySelector('.papel')) {
        dir.searchParams.delete('imprimir');
        history.replaceState(history.state, '', dir.pathname + dir.search);
        setTimeout(() => print(), 300);
      }
      const form = document.querySelector<HTMLFormElement>('#venta');
      if (form) {
        const lineas = form.querySelector<HTMLElement>('#lineas')!;
        const nota = form.querySelector<HTMLElement>('#nota-cantidad')!;
        const agregar = form.querySelector<HTMLButtonElement>('#agregar-linea')!;
        const molde = lineas.querySelector<HTMLElement>('.linea')!.cloneNode(true) as HTMLElement; // línea en blanco para "Agregar otro"
        const selects = () => [...lineas.querySelectorAll<HTMLSelectElement>('select[name=animal]')];
        const cantidadDe = (linea: Element) => linea.querySelector<HTMLInputElement>('input[name=cantidad]')!;
        const totalAnimales = selects()[0].options.length - 1;

        // La cantidad de cada animal no puede pasar de lo que hay.
        const limitar = (linea: HTMLElement) => {
          const sel = linea.querySelector<HTMLSelectElement>('select')!;
          const cant = cantidadDe(linea);
          const stock = Number(sel.selectedOptions[0]?.dataset.stock);
          if (stock) { cant.max = String(stock); cant.setCustomValidity(Number(cant.value) > stock ? `Solo quedan ${stock}` : ''); }
          else { cant.removeAttribute('max'); cant.setCustomValidity(''); }
        };

        // Muestra u oculta lo que depende de lo elegido. Se debe elegir al menos un animal, producto o servicio.
        const sincronizar = () => {
          const todas = selects();
          const hayServicio = !!form.querySelector('input[name=servicio]:checked');
          const elegidos = todas.map(s => s.value).filter(Boolean);
          todas.forEach((s, i) => {
            const linea = s.closest<HTMLElement>('.linea')!;
            linea.querySelector<HTMLElement>('.linea-cantidad')!.hidden = !s.value;
            linea.querySelector<HTMLElement>('.linea-quitar')!.hidden = todas.length < 2;
            s.required = i === 0 && !elegidos.length && !hayServicio;
            // un animal ya elegido en otra línea no se puede repetir
            [...s.options].forEach(o => { o.disabled = !!o.value && o.value !== s.value && elegidos.includes(o.value); });
          });
          nota.hidden = elegidos.length > 0;
          agregar.hidden = !elegidos.length || todas.some(s => !s.value) || elegidos.length >= totalAnimales;
        };

        lineas.addEventListener('change', e => {
          const sel = (e.target as HTMLElement).closest('select');
          if (!sel) return;
          const linea = sel.closest<HTMLElement>('.linea')!;
          if (!sel.value) cantidadDe(linea).value = '1';
          limitar(linea);
          sincronizar();
        });
        lineas.addEventListener('input', e => {
          const campo = e.target as HTMLInputElement;
          if (campo.name === 'cantidad') limitar(campo.closest<HTMLElement>('.linea')!);
        });
        lineas.addEventListener('click', e => {
          const objetivo = e.target as HTMLElement;
          const paso = objetivo.closest<HTMLElement>('.qty-btn');
          if (paso) {
            const linea = paso.closest<HTMLElement>('.linea')!;
            const cant = cantidadDe(linea);
            const max = Number(cant.max) || Infinity;
            cant.value = String(Math.min(Math.max(1, (Math.floor(Number(cant.value)) || 1) + Number(paso.dataset.paso)), max));
            limitar(linea);
          } else if (objetivo.closest('.linea-quitar')) {
            objetivo.closest('.linea')!.remove();
            sincronizar();
          }
        });
        agregar.addEventListener('click', () => {
          const nueva = molde.cloneNode(true) as HTMLElement;
          nueva.querySelector('.field-label')!.textContent = 'Otro animal o producto';
          lineas.append(nueva);
          sincronizar();
          nueva.querySelector('select')!.focus();
        });
        form.addEventListener('change', e => { if ((e.target as HTMLInputElement).name === 'servicio') sincronizar(); });
        sincronizar();
      }
      });
    </script>
  </body>
</html>

<style is:global>
  :root {
    --paper: #f4f6f5; --sheet: #faf9f4; --ink: #1d2a24; --green: #2f6f4f; --green-deep: #24583f; --green-soft: #eaf2ec;
    --line: #c8d1cb; --line-strong: #87968d; --muted: #526258; --error: #94463d; --error-bg: #fcf0ed; --error-line: #edc9c2;
    --shadow: 0 10px 30px rgba(29, 42, 36, .08); --body: 'DM Sans', system-ui, sans-serif; --display: 'Space Grotesk', sans-serif;
  }
  *, *::before, *::after { box-sizing: border-box; }
  html, body { margin: 0; padding: 0; }
  body { background: var(--paper); color: var(--ink); font-family: var(--body); }
  button, input, select { font: inherit; }
  [hidden] { display: none !important; }
  .sr-only { position: absolute; width: 1px; height: 1px; margin: -1px; padding: 0; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0; }

  .cash-page { min-height: 100vh; min-height: 100dvh; background: var(--paper); color: var(--ink); }
  .cash-top { border-bottom: 1px solid var(--line); background: var(--paper); }
  .cash-top-inner { width: min(1160px, calc(100% - 72px)); min-height: 108px; margin: auto; display: flex; align-items: center; justify-content: space-between; gap: 28px; }
  .cash-brand { display: flex; align-items: center; gap: 16px; color: var(--ink); text-decoration: none; min-width: 0; }
  .cash-logo { display: block; width: 72px; height: 72px; flex: none; object-fit: contain; background: #fff; border-radius: 50%; padding: 4px; box-shadow: 0 4px 16px rgba(29, 42, 36, .12); }
  .cash-brand-name { display: block; font: 700 24px/1.05 var(--display); letter-spacing: -.045em; }
  .cash-brand-sub { display: block; margin-top: 5px; color: var(--muted); font-size: 13px; letter-spacing: .01em; }
  .cash-history { display: inline-flex; align-items: center; gap: 9px; min-height: 44px; padding: 0 2px; border-bottom: 1px solid var(--green); color: var(--green-deep); text-decoration: none; font-size: 14px; font-weight: 700; flex: none; }
  .cash-history i { font-size: 17px; }
  .cash-history:focus-visible, .cash-select:focus-visible, .cash-input:focus-visible, .payment-choice:focus-within, .cash-submit:focus-visible, .grooming-toggle:focus-within { outline: 3px solid rgba(47, 111, 79, .28); outline-offset: 3px; }

  .cash-main { width: min(1160px, calc(100% - 72px)); margin: 0 auto; padding: 57px 0 54px; }
  .cash-intro { display: grid; grid-template-columns: minmax(0, 1.5fr) minmax(220px, .65fr); align-items: end; gap: 38px; margin-bottom: 48px; }
  .cash-title { max-width: 780px; margin: 0; font: 600 clamp(46px, 6.4vw, 82px)/.94 var(--display); letter-spacing: -.075em; }
  .cash-intro-copy { max-width: 260px; margin: 0 0 5px; color: var(--muted); font-size: 16px; line-height: 1.5; }

  .cash-sheet { background: var(--sheet); border-top: 1px solid var(--ink); border-bottom: 1px solid var(--ink); }
  .sheet-heading { display: flex; align-items: baseline; justify-content: space-between; gap: 20px; padding: 20px 28px 18px; border-bottom: 1px solid var(--line); }
  .sheet-heading h2 { margin: 0; font: 600 21px/1.15 var(--display); letter-spacing: -.035em; }
  .seller-row { display: grid; grid-template-columns: minmax(220px, .55fr) minmax(0, 1fr); align-items: center; gap: 48px; padding: 30px 28px 32px; }
  .row-title { margin: 0; font: 600 25px/1.08 var(--display); letter-spacing: -.045em; }
