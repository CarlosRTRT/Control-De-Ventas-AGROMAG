---
import PantallaAcceso from '../components/PantallaAcceso.astro';
import { bloqueado, ipDe, registrarFallo } from '../lib/acceso';
import { db, pinCorrecto } from "../lib/db";
import { randomBytes } from "node:crypto";

if (Astro.request.method === "POST") {
  if ((process.env.ADMIN_PIN || "").length < 4)
    throw new Error(
      "Falta la variable ADMIN_PIN (mínimo 4 caracteres) en el servidor.",
    );
  const ip = ipDe(Astro.request, Astro.clientAddress);
  if (bloqueado(ip))
    return Astro.redirect("/login?msg=" + encodeURIComponent("Demasiados intentos. Espere unos minutos."), 303);
  const pin = String((await Astro.request.formData()).get("pin") || "");
  if (!pinCorrecto(pin)) {
    registrarFallo(ip);
    await new Promise((r) => setTimeout(r, 1000)); // frena intentos de adivinar el PIN
    return Astro.redirect(
      "/login?msg=" + encodeURIComponent("PIN incorrecto"),
      303,
    );
  }
  const token = randomBytes(24).toString("hex");
  db.prepare(`DELETE FROM sesiones WHERE expira <= datetime('now')`).run();
  db.prepare("INSERT INTO sesiones (token, expira) VALUES (?, datetime('now','+20 minutes'))").run(token);
  Astro.cookies.set("s", token, {
    httpOnly: true,
    sameSite: "strict",
    path: "/",
    maxAge: 43200,
    secure:
      Astro.url.protocol === "https:" || process.env.COOKIE_SECURE === "1",
  });
  return Astro.redirect("/admin", 303);
}

const error = Astro.url.searchParams.get("msg");
---

<PantallaAcceso
  titulo="Administración"
  eyebrow="Espacio del propietario"
  titular={["Orden para", "cuidar mejor."]}
  descripcion="Ventas, inventario y cierres de Agromag en un solo lugar."
  etiquetaVerde="Administración segura"
  saludo="Bienvenido de nuevo"
  instrucciones="Ingresa tu PIN de propietario para administrar las ventas y el inventario."
  campo="PIN del dueño"
  nombreCampo="pin"
  tipo="password"
  boton="Entrar al panel"
  nota="Acceso reservado al propietario de Agromag."
  error={error}
/>
